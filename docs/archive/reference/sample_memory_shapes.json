        {
          "id": "4c5be04e-5b27-4f06-bd4f-d54fadd9e3af",
          "fact_type": "observation",
          "text": "The path summarized during branch switching is the segment from the old leaf back to the common ancestor with the target, stopping at the common ancestor or the first compaction node encountered.",
          "context": "",
          "date": "2026-04-30T15:14:49.172152+00:00",
          "chunk_id": null,
          "proof_count": 1,
          "tags": [
