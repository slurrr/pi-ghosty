{
  "defaults": {
    "projectTag": "project:pi-ghosty",
    "runtime": {
      "vllmBaseUrl": "http://localhost:8002/v1",
      "hindsightBaseUrl": "http://localhost:8888",
      "hindsightBankId": "pi-ghosty",
      "model": {
        "contextWindow": 131072,
        "maxTokens": 8192
      }
    },
    "persistence": {
      "enabled": false
    },
    "memory": {
      "recall": {
        "maxTokens": 2048,
        "budget": "mid",
        "tagsMatch": "all",
        "types": ["observation", "world", "experience"],
        "maxFacts": 30,
        "queryMaxTokens": 420,
        "queryTimestampMode": "now",
        "includeSourceFacts": true,
        "includeSourceFactsMaxTokens": 4096,
        "includeChunks": true,
        "includeChunksMaxTokens": 8192,
        "async": true
      },
      "retain": {
        "context": "pi-ghosty agent session transcript",
        "async": true,
        "timestampMode": "now",
        "updateMode": "replace",
        "waitForCompletion": false,
        "waitTimeoutMs": 20000,
        "observationScopes": {
          "mode": "custom",
          "includeProjectScope": true,
          "includeAgentScope": true,
          "includeSessionScope": false
        }
      },
      "operations": {
        "enabled": true,
        "pollIntervalMs": 1000,
        "timeoutMs": 20000
      },
      "reflect": {
        "enabled": false,
        "mode": "manual",
        "budget": "low"
      }
    },
    "workflowMonitor": {
      "enabled": true,
      "heartbeatMs": 120000,
      "reviewCadenceMs": 900000,
      "lookbackHours": 72,
      "candidateThreshold": 2,
      "winnerThreshold": 6,
      "surfaceTopN": 5
    }
  },
  "agents": {
    "coordinator": {
      "tools": ["read", "grep", "find", "ls", "delegate", "delegate_batch", "edit", "bash", "write"],
      "thinkingLevel": "medium",
      "defaultModel": "openai-codex/gpt-5.4-mini"
    },
    "coder": {
      "tools": ["read", "grep", "find", "ls", "edit", "write", "bash"],
      "thinkingLevel": "low",
      "defaultModel": "openai-codex/gpt-5.3-codex"
    },
    "researcher": {
      "tools": ["read", "grep", "find", "ls", "write", "edit", "web_search"],
      "thinkingLevel": "medium",
      "defaultModel": "openai-codex/gpt-5.2"
    },
    "reviewer": {
      "tools": ["read", "grep", "find", "ls", "write", "edit"],
      "thinkingLevel": "medium",
      "defaultModel": "openai-codex/gpt-5.2"
    },
    "memory": {
      "tools": ["read", "grep", "find", "ls"],
      "thinkingLevel": "medium",
      "defaultModel": "vllm/omnicoder-9b"
    }
  },
  "requestRules": [
    {
      "when": {
        "model": ["vllm/omnicoder-9b"]
      },
      "apply": {
        "sampling": {
          "temperature": 0.6,
          "topP": 0.95,
          "topK": 20,
          "minP": 0.05,
          "repetitionPenalty": 1.0,
          "presencePenalty": null,
          "frequencyPenalty": null
        }
      }
    },
    {
      "when": {
        "model": ["vllm/gemma-4-e4b"]
      },
      "apply": {
        "sampling": {
          "temperature": 1.0,
          "topP": 0.95,
          "topK": 64
        }
      }
    },
    {
      "when": {
        "agent": ["coordinator"],
        "model": ["vllm/omnicoder-9b"]
      },
      "apply": {
        "sampling": {
          "temperature": 0.69,
          "topP": 1.0,
          "topK": -1,
          "minP": 0.05,
          "presencePenalty": 0.69
        },
        "extra_body": {
          "chat_template_kwargs": {
            "enable_thinking": true
          }
        }
      }
    },
    {
      "when": {
        "agent": ["coordinator"],
        "model": ["vllm/gemma-4-e4b"]
      },
      "apply": {
        "sampling": {
          "temperature": 1.0,
          "topP": 0.95,
          "topK": 64,
          "presencePenalty": 0.9
        },
        "extra_body": {
          "chat_template_kwargs": {
            "enable_thinking": true
          }
        }
      }
    },
    {
      "when": {
        "agent": ["researcher", "reviewer", "memory"],
        "model": ["vllm/omnicoder-9b"]
      },
      "apply": {
        "sampling": {
          "temperature": 0.6,
          "topP": 0.95,
          "topK": -1,
          "minP": 0.05,
          "repetitionPenalty": 1.0
        }
      }
    },
    {
      "when": {
        "agent": ["researcher", "reviewer", "memory"],
        "model": ["vllm/gemma-4-e4b"]
      },
      "apply": {
        "sampling": {
          "temperature": 1.0,
          "topP": 0.95,
          "topK": 64,
          "repetitionPenalty": 1.0
        }
      }
    },
    {
      "when": {
        "agent": ["memory"],
        "model": ["vllm/omnicoder-9b"]
      },
      "apply": {
        "sampling": {
          "topP": 1.0
        }
      }
    },
    {
      "when": {
        "agent": ["memory"],
        "model": ["vllm/gemma-4-e4b"]
      },
      "apply": {
        "sampling": {
          "topP": 1.0
        }
      }
    }
  ],
  "routing": {
    "defaults": {
      "maxParallelDelegations": 2,
      "maxNumSeqHint": 4,
      "maxLoadedSessionsTotal": 8,
      "maxLoadedSessionsPerPeer": 4,
      "compactThresholdPercent": 75,
      "retireAfterCompactions": 5,
      "semantic": {
        "enabled": true,
        "updateCooldownMs": 3600000,
        "maxCandidates": 8,
        "model": "default"
      }
    },
    "budgetGuards": {
      "maxDelegationsPerUserTurn": 8,
      "maxNewSessionsPerUserTurn": 4,
      "maxFrontierDelegationsPerUserTurn": 4
    }
  },
  "routingRules": [
    {
      "when": {
        "model": ["vllm/*"]
      },
      "apply": {
        "maxParallelDelegations": 2,
        "maxNumSeqHint": 4,
        "maxLoadedSessionsTotal": 8,
        "maxLoadedSessionsPerPeer": 4
      }
    },
    {
      "when": {
        "model": ["openai-codex/*"]
      },
      "apply": {
        "maxParallelDelegations": 8,
        "maxNumSeqHint": 12
      }
    }
  ],
  "modelScopePresets": {
    "frontier-only": ["openai-codex/*"],
    "hybrid-default": ["openai-codex/*", "vllm/*"],
    "local-only": ["vllm/*"],
    "frontier-preferred": ["openai-codex/*", "vllm/*"],
    "local-preferred": ["vllm/*", "openai-codex/*"],
    "omnicoder-only": ["vllm/omnicoder-9b"],
    "gemma-only": ["vllm/gemma-4-e4b"],
    "local-multi": ["vllm/omnicoder-9b", "vllm/gemma-4-e4b"],
    "hybrid-multi": ["openai-codex/*", "vllm/omnicoder-9b", "vllm/gemma-4-e4b"]
  }
}
