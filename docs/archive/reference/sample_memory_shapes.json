        {
          "id": "25923e46-6e1a-4c6f-83b4-a345bc9ec494",
          "fact_type": "observation",
          "text": "When switching branches, the user can switch immediately without summarizing, generate a summary using the default prompt, or summarize using a custom prompt by entering focus instructions in an editor.",
