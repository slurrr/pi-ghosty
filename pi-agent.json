    "memory": {
      "tools": ["read", "grep", "find", "ls"],
      "thinkingLevel": "off",
      "sampling": {
        "temperature": 0.6,
        "topP": 1.0,
        "topK": -1,
        "minP": 0.05,
        "repetitionPenalty": 1.0
      }
    }
