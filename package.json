{
  "name": "pi-ghosty",
  "version": "1.0.0",
  "description": "Single-model multi-peer agent host (pi-mono + Telegram + Hindsight)",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "tui": "tsx src/index.ts",
    "dev:debug": "GHOSTY_DEBUG_ALL=1 tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "kill": "node scripts/ghosty-kill.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mariozechner/pi-ai": "^0.65.0",
    "@mariozechner/pi-coding-agent": "^0.65.0",
    "@vectorize-io/hindsight-client": "^0.4.22",
    "dotenv": "^17.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
