# Core
PROJECT_TAG=project:pi-ghosty
VLLM_BASE_URL=http://localhost:8002/v1
GHOSTY_AGENT_CONFIG_PATH=./pi-agent.json

# Telegram (single-user v1)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=

# Hindsight
HINDSIGHT_BASE_URL=http://localhost:8888
# legacy single-bank override (kept for compatibility)
HINDSIGHT_BANK_ID=pi-ghosty
# split-bank defaults
HINDSIGHT_PROCEDURAL_BANK_ID=pi-ghosty-procedural
HINDSIGHT_PERSONAL_BANK_ID=pi-ghosty-personal

# Feature toggles
GHOSTY_DISABLE_MEMORY=0

# Debug (all default off / 0)
GHOSTY_DEBUG_ALL=0
GHOSTY_TRACE_SYSTEM_PROMPT=0
GHOSTY_DEBUG_TOOL_BLOCKS=0
GHOSTY_DEBUG_TOOL_GATING=0
GHOSTY_DEBUG_TOOL_SURFACE=0
GHOSTY_DEBUG_PROMPT_PARTS=0
